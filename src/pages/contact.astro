---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { pageText } from "../data/pages";
import { contactLinks, getContactUrl } from "../data/links";
const contacts = contactLinks.map((item) => ({
  ...item,
  href: getContactUrl(item.url),
}));
---

<BaseLayout title="Contact">
  <section class="section contact-page">
    <div class="container">
      <PageHeader
        label="CONTACT"
        title="おたよりはこちら"
        description={pageText.contact.introduction}
      />
      <div class="contact-letters">
        {contacts.map((item, index) => (
          <section class="contact-letter">
            <span class="contact-letter__decor" aria-hidden="true">
              {index ? "☆" : "♡"}
            </span>
            <p class="eyebrow">{index ? "MESSAGE" : "INFORMATION"}</p>
            <h2>{item.label}</h2>
            <p>{item.description}</p>
            {item.href ? (
              <a
                class="soft-link soft-link--white"
                href={item.href}
                target={item.href.startsWith("mailto:") ? undefined : "_blank"}
                rel={
                  item.href.startsWith("mailto:")
                    ? undefined
                    : "noopener noreferrer"
                }
                referrerpolicy={
                  item.href.startsWith("mailto:") ? undefined : "no-referrer"
                }
              >
                お問い合わせはこちら
              </a>
            ) : (
              <span class="contact-letter__soon">現在準備中です。</span>
            )}
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
