---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { pageText } from "../data/pages";
import guidelinesData from "../content/guidelines.json";

type GuidelineItem = {
  category: string;
  title: string;
  body: string;
  published?: boolean;
  important?: boolean;
};

type GuidelineImage = {
  image: string;
  alt?: string;
  caption?: string;
  published?: boolean;
};

type GuidelineData = {
  rules?: GuidelineItem[];
  secondaryCreationImages?: GuidelineImage[];
};

const content: GuidelineData = guidelinesData;

const validRules = (content.rules ?? []).filter(
  (entry) =>
    entry &&
    entry.published !== false &&
    ["streaming", "secondaryCreation", "clips"].includes(entry.category) &&
    typeof entry.title === "string" &&
    entry.title.trim().length > 0 &&
    typeof entry.body === "string" &&
    entry.body.trim().length > 0,
);

const categories = [
  {
    id: "streaming",
    key: "streaming",
    label: "STREAMING",
    title: "配信視聴ガイドライン",
    legacy: pageText.guidelines.streaming,
  },
  {
    id: "secondary-creation",
    key: "secondaryCreation",
    label: "FAN CREATIONS",
    title: "二次創作について",
    legacy: pageText.guidelines.secondaryCreation,
  },
  {
    id: "clips",
    key: "clips",
    label: "CLIPS",
    title: "切り抜きについて",
    legacy: pageText.guidelines.clips,
  },
].map((category) => {
  const entries = validRules.filter((entry) => entry.category === category.key);

  return {
    ...category,
    importantEntries: entries.filter((entry) => entry.important === true),
    regularEntries: entries.filter((entry) => entry.important !== true),
    showLegacy: entries.length === 0 ||
      (category.legacy.trim().length > 0 && !category.legacy.trim().startsWith("ここに")),
  };
});

const secondaryCreationImages = (content.secondaryCreationImages ?? [])
  .filter(
    (item) =>
      item &&
      item.published !== false &&
      typeof item.image === "string" &&
      /^\/images\/[^?#\\]+\.(png|jpe?g|webp|avif|gif)$/i.test(item.image) &&
      !item.image.split("/").includes(".."),
  )
  .slice(0, 3);
---

<BaseLayout title="Guidelines">
  <section class="section guidelines-page">
    <div class="container">
      <PageHeader
        label="GUIDELINES"
        title="みんなへのお願い"
        description={pageText.guidelines.introduction}
      />

      <div class="guidelines-content" data-guidelines>
        <div class="guidelines-tabs" role="tablist" aria-label="ガイドラインの種類">
          {categories.map((category, index) => (
            <button
              class="guidelines-tab"
              type="button"
              role="tab"
              id={`guidelines-tab-${category.id}`}
              aria-controls={`guidelines-panel-${category.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? 0 : -1}
            >
              {category.title}
            </button>
          ))}
        </div>

        {categories.map((category, index) => (
          <section
            class="guidelines-panel"
            id={`guidelines-panel-${category.id}`}
            role="tabpanel"
            aria-labelledby={`guidelines-tab-${category.id}`}
            tabindex="0"
            hidden={index !== 0}
          >
            <div class="guidelines-panel__header">
              <p class="eyebrow">{category.label}</p>
              <h2>{category.title}</h2>
            </div>

            {category.showLegacy && category.legacy.trim().length > 0 && (
              <p class="guidelines-panel__intro">{category.legacy}</p>
            )}

            {category.importantEntries.length > 0 && (
              <div class="guidelines-important">
                {category.importantEntries.map((entry) => (
                  <section class="guidelines-important__item">
                    <h3>{entry.title}</h3>
                    <p>{entry.body}</p>
                  </section>
                ))}
              </div>
            )}

            {category.regularEntries.length > 0 && (
              <div class="guidelines-entries">
                {category.regularEntries.map((entry) => (
                  <details class="guidelines-entry">
                    <summary>
                      <span class="guidelines-entry__title">{entry.title}</span>
                      <span class="guidelines-entry__symbol" aria-hidden="true"></span>
                    </summary>
                    <div class="guidelines-entry__body">
                      <p>{entry.body}</p>
                    </div>
                  </details>
                ))}
              </div>
            )}

            {category.id === "secondary-creation" && (
              <div class="guidelines-fanart">
                {secondaryCreationImages.length > 0 && (
                  <div class="guidelines-images" aria-label="二次創作の参考画像">
                    {secondaryCreationImages.map((image, imageIndex) => (
                      <figure class="guidelines-images__item">
                        <div class="guidelines-images__frame">
                          <img
                            src={image.image}
                            alt={image.alt?.trim() || `二次創作の参考画像 ${imageIndex + 1}`}
                            loading="lazy"
                            decoding="async"
                          />
                        </div>
                        {image.caption?.trim() && (
                          <figcaption>{image.caption}</figcaption>
                        )}
                      </figure>
                    ))}
                  </div>
                )}
                <a class="text-arrow" href="/fan-art/">Fan Artを見る →</a>
              </div>
            )}
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function setupGuidelineTabs() {
    document.querySelectorAll<HTMLElement>("[data-guidelines]").forEach((root) => {
      if (root.dataset.initialized === "true") return;
      root.dataset.initialized = "true";

      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

      const activate = (index: number, focus = false) => {
        tabs.forEach((tab, tabIndex) => {
          const selected = tabIndex === index;
          tab.setAttribute("aria-selected", String(selected));
          tab.tabIndex = selected ? 0 : -1;
          panels[tabIndex].hidden = !selected;
        });

        if (focus) tabs[index].focus();
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => activate(index));

        tab.addEventListener("keydown", (event) => {
          let next = index;
          if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
          else if (event.key === "ArrowLeft") next = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === "Home") next = 0;
          else if (event.key === "End") next = tabs.length - 1;
          else return;

          event.preventDefault();
          activate(next, true);
        });
      });
    });
  }

  setupGuidelineTabs();
  document.addEventListener("astro:page-load", setupGuidelineTabs);
</script>

<style>
  .guidelines-content {
    width: min(100%, 960px);
    margin-inline: auto;
  }

  .guidelines-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 24px;
  }

  .guidelines-tab {
    appearance: none;
    min-height: 46px;
    padding: 10px 20px;
    border: 1px solid #c8e3f0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.84);
    color: #4a819e;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .guidelines-tab[aria-selected="true"] {
    border-color: #79b2d2;
    background: #dff1fb;
    color: #2b6f93;
  }

  .guidelines-tab:focus-visible,
  .guidelines-entry summary:focus-visible,
  .guidelines-panel:focus-visible {
    outline: 3px solid #6ca8ca;
    outline-offset: 3px;
  }

  .guidelines-panel {
    min-width: 0;
    padding: clamp(22px, 4vw, 42px);
    border: 1px solid rgba(196, 227, 243, 0.9);
    border-radius: 30px 18px 36px 20px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.9), rgba(232, 245, 254, 0.6));
  }

  .guidelines-panel[hidden] {
    display: none;
  }

  .guidelines-panel__header {
    margin-bottom: 24px;
  }

  .guidelines-panel__header h2 {
    margin: 6px 0 0;
    color: #3b7796;
    font-size: var(--font-heading);
  }

  .guidelines-panel__intro,
  .guidelines-important__item p,
  .guidelines-entry__body p {
    margin: 0;
    color: #557c93;
    font-size: var(--font-body);
    line-height: 1.95;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  .guidelines-panel__intro {
    margin-bottom: 24px;
  }

  .guidelines-important {
    display: grid;
    gap: 14px;
    margin-bottom: 22px;
  }

  .guidelines-important__item {
    padding: 18px 20px;
    border-left: 4px solid #7cb4d2;
    border-radius: 0 12px 12px 0;
    background: rgba(226, 243, 252, 0.9);
  }

  .guidelines-important__item h3 {
    margin: 0 0 8px;
    color: #2f7296;
    font-size: clamp(15px, 1.8vw, 19px);
  }

  .guidelines-entries {
    display: grid;
    gap: 12px;
  }

  .guidelines-entry {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #d0e6f2;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.92);
  }

  .guidelines-entry summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 58px;
    padding: 15px 18px;
    color: #3b7796;
    font-size: clamp(14px, 1.65vw, 17px);
    font-weight: 700;
    line-height: 1.55;
    list-style: none;
    cursor: pointer;
  }

  .guidelines-entry summary::-webkit-details-marker {
    display: none;
  }

  .guidelines-entry__symbol {
    position: relative;
    flex: 0 0 12px;
    height: 12px;
  }

  .guidelines-entry__symbol::before,
  .guidelines-entry__symbol::after {
    position: absolute;
    top: 50%;
    left: 0;
    width: 12px;
    height: 2px;
    border-radius: 2px;
    background: #6d9ebc;
    content: "";
  }

  .guidelines-entry__symbol::after {
    transform: rotate(90deg);
  }

  .guidelines-entry[open] .guidelines-entry__symbol::after {
    display: none;
  }

  .guidelines-entry__body {
    padding: 17px 18px 20px;
    border-top: 1px solid #e3eff6;
  }

  .guidelines-fanart {
    margin-top: 24px;
  }

  .guidelines-images {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 20px;
  }

  .guidelines-images__item {
    min-width: 0;
    margin: 0;
  }

  .guidelines-images__frame {
    display: grid;
    place-items: center;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 1px solid #d3eaf5;
    border-radius: 14px;
    background: #fff;
  }

  .guidelines-images__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .guidelines-images__item figcaption {
    margin-top: 8px;
    color: #6d8b9d;
    font-size: var(--font-body);
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  @media (max-width: 760px) {
    .guidelines-images {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 540px) {
    .guidelines-tabs {
      gap: 8px;
    }

    .guidelines-tab {
      flex: 1 1 auto;
      padding: 10px 12px;
      font-size: 13px;
    }

    .guidelines-panel {
      padding: 22px 15px;
      border-radius: 20px;
    }

    .guidelines-entry summary {
      padding: 14px;
    }

    .guidelines-entry__body {
      padding: 15px 14px 18px;
    }

    .guidelines-images {
      grid-template-columns: minmax(0, 1fr);
      max-width: 360px;
    }
  }
</style>
