
---
interface Props {
    side?: "left" | "right";
}

const { side = "left" } = Astro.props;

const showPeekCharacter = true;
const videoSrc = "/images/0001-0120.webm";
const imageSrc = "/images/peek-Character.webp";
---

{showPeekCharacter && (
    <div
        class="peek-character"
        data-side={side}
        data-peek-character
        data-peek-webp-ready="false"
        aria-hidden="true"
    >
        <video
            class="peek-video peek-video--desktop"
            src={videoSrc}
            autoplay
            muted
            loop
            playsinline
            preload="auto"
        ></video>

        <img
            class="peek-video peek-video--mobile"
            src={imageSrc}
            alt=""
            loading="eager"
            decoding="async"
            draggable="false"
            data-peek-image
        />
    </div>
)}

<script>
    function setupPeekCharacter() {
        const mobileQuery = window.matchMedia(
            "(max-width: 1024px), (hover: none) and (pointer: coarse)",
        );

        const characters = document.querySelectorAll<HTMLElement>(
            "[data-peek-character]",
        );

        characters.forEach((character) => {
            if (character.parentElement !== document.body) {
                document.body.appendChild(character);
            }

            const video = character.querySelector<HTMLVideoElement>("video");
            const image = character.querySelector<HTMLImageElement>(
                "[data-peek-image]",
            );

            if (!video || !image) return;

            const updateImage = () => {
                character.dataset.peekWebpReady =
                    image.complete && image.naturalWidth > 0
                        ? "true"
                        : "false";
            };

            const updateVideo = () => {
                if (mobileQuery.matches) {
                    video.pause();
                } else if (video.paused) {
                    video.play().catch(() => {});
                }
            };

            video.playbackRate = 0.8;

            if (character.dataset.peekInitialized !== "true") {
                image.addEventListener("load", updateImage);
                image.addEventListener("error", updateImage);
                mobileQuery.addEventListener("change", updateVideo);
                character.dataset.peekInitialized = "true";
            }

            updateImage();
            updateVideo();
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupPeekCharacter);
    } else {
        setupPeekCharacter();
    }

    document.addEventListener("astro:page-load", setupPeekCharacter);
</script>

<style>
    .peek-character {
        --peek-width: clamp(150px, 18vw, 240px);
        --peek-visible: -40%;
        --peek-bottom-offset: -6px;
        --peek-angle: 10deg;
        --peek-duration: 28s;

        position: fixed;
        left: 0;
        bottom: var(--peek-bottom-offset);

        width: var(--peek-width);
        height: auto;

        z-index: 9999;
        pointer-events: none;

        background: transparent;
        overflow: visible;
    }

    .peek-video {
        display: block;
        width: 100%;
        height: auto;
        max-width: none;

        object-fit: contain;

        background: transparent;
        border: none;
        box-shadow: none;

        transform-origin: 45% 82%;
        will-change: transform;

        transform: translateX(-108%) rotate(0deg);

        animation: peek-left-gentle
            var(--peek-duration) ease-in-out infinite;

        animation-fill-mode: both;
    }

    .peek-video--mobile {
        display: none;
    }

    @keyframes peek-left-gentle {
        0%,
        77.5% {
            transform: translateX(-108%) rotate(0deg);
        }

        81.6% {
            transform: translateX(-100%) rotate(0deg);
        }

        85.7%,
        89.8% {
            transform: translateX(var(--peek-visible))
                rotate(var(--peek-angle));
        }

        93.9% {
            transform: translateX(-100%) rotate(2deg);
        }

        100% {
            transform: translateX(-108%) rotate(0deg);
        }
    }

    .peek-character[data-side="right"] {
        left: auto;
        right: 0;
    }

    .peek-character[data-side="right"] .peek-video {
        transform-origin: 55% 82%;
        transform: translateX(108%) rotate(0deg);
        animation-name: peek-right-gentle;
    }

    @keyframes peek-right-gentle {
        0%,
        77.5% {
            transform: translateX(108%) rotate(0deg);
        }

        81.6% {
            transform: translateX(100%) rotate(0deg);
        }

        85.7%,
        89.8% {
            transform: translateX(40%) rotate(-10deg);
        }

        93.9% {
            transform: translateX(100%) rotate(-2deg);
        }

        100% {
            transform: translateX(108%) rotate(0deg);
        }
    }

    @media (max-width: 1024px),
        (hover: none) and (pointer: coarse) {

        .peek-video--desktop {
            display: none;
        }

        .peek-character[data-peek-webp-ready="true"]
        .peek-video--mobile {
            display: block;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .peek-video {
            animation: none !important;
            transform: translateX(-108%) rotate(0deg);
        }

        .peek-character[data-side="right"] .peek-video {
            transform: translateX(108%) rotate(0deg);
        }
    }
</style>
