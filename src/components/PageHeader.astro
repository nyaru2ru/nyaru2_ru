---
interface Props {
  label: string;
  title: string;
  description: string;
}

const { label, title, description } = Astro.props;
---

<header class="page-intro">
  <div class="page-intro__decor" aria-hidden="true">
    <span>☆</span><span>○</span><span>♡</span><span>☆</span>
  </div>
  <p class="eyebrow">{label}</p>
  <h1>{title}</h1>
  <p class="page-intro__description">{description}</p>
</header>

<style>
  .page-intro {
    position: relative;
    isolation: isolate;
  }

  .page-intro > :not(.page-intro__decor) {
    position: relative;
    z-index: 1;
  }

  .page-intro__decor {
    position: absolute;
    inset: 0;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .page-intro__decor span {
    position: absolute;
    font-family: "Segoe UI Symbol", "Noto Sans Symbols 2", sans-serif;
    font-weight: 400;
    line-height: 1;
    color: #81b8d5;
    opacity: 0.34;
    animation: none;
  }

  .page-intro__decor span:nth-child(1) {
    top: 0;
    right: 6%;
    font-size: clamp(24px, 3vw, 36px);
    transform: rotate(12deg);
  }

  .page-intro__decor span:nth-child(2) {
    display: none;
  }

  .page-intro__decor span:nth-child(3) {
    bottom: -12px;
    left: 4%;
    font-size: 24px;
    transform: rotate(-12deg);
  }

  .page-intro__decor span:nth-child(4) {
    right: 1%;
    bottom: -18px;
    font-size: 19px;
    opacity: 0.2;
  }

  .page-intro h1 {
    font-size: clamp(24px, 3.3vw, 42px);
    line-height: 1.4;
  }

  @media (max-width: 520px) {
    .page-intro h1 {
      font-size: clamp(23px, 6.2vw, 28px);
    }

    .page-intro__decor span:nth-child(1) {
      right: 3%;
      font-size: 23px;
    }

    .page-intro__decor span:nth-child(3),
    .page-intro__decor span:nth-child(4) {
      display: none;
    }
  }
</style>
