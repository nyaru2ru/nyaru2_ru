---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatJapaneseDate } from "../lib/formatJapaneseDate";
import PageHeader from "../components/PageHeader.astro";
import { pageText } from "../data/pages";
import { contentItems, type ContentKind } from "../data/contents";
import { salesLinks, getPublicUrl } from "../data/links";
import contentsData from "../content/contents.json";

type ContentsVideo = {
    title: string;
    videoId: string;
    published?: boolean;
    thumbnail?: string;
};

type ContentsVideoData = {
    coverVideos: ContentsVideo[];
    movieVideos: ContentsVideo[];
};

const videoData: ContentsVideoData = contentsData;

const shopImages: Record<string, { src: string; sample: boolean }> = {};

function getVideos(items: ContentsVideo[]): ContentsVideo[] {
    return items
        .filter(
            (item) =>
                item &&
                item.published !== false &&
                typeof item.title === "string" &&
                item.title.trim().length > 0 &&
                typeof item.videoId === "string" &&
                /^[a-zA-Z0-9_-]{11}$/.test(item.videoId),
        )
        .slice(0, 3);
}

const availableShops = salesLinks.flatMap((item) => {
    const href = getPublicUrl(item.url);
    return href ? [{ ...item, href, image: shopImages[item.id] ?? null }] : [];
});

const categories: {
    kind: ContentKind;
    label: string;
    title: string;
    videos: ContentsVideo[];
}[] = [
    {
        kind: "cover",
        label: "COVER SONGS",
        title: "歌ってみた",
        videos: getVideos(videoData.coverVideos),
    },
    {
        kind: "video",
        label: "MOVIES",
        title: "おすすめ動画",
        videos: getVideos(videoData.movieVideos),
    },
];
---

<BaseLayout title="Contents">
    <section class="section contents-page">
        <div class="container">
            <PageHeader
                label="CONTENTS"
                title="コンテンツ"
                description={pageText.contents.introduction}
            />
            <div class="contents-islands">
                {categories.map((category) => {
                    const items = contentItems.filter(
                        (item) => item.kind === category.kind,
                    );

                    return (
                        <section
                            class="contents-island"
                            aria-label={category.title}
                        >
                            <header>
                                <p class="eyebrow">{category.label}</p>
                                <h2>{category.title}</h2>
                            </header>

                            {category.videos.length > 0 && (
                                <div class="contents-videos">
                                    {category.videos.map((video) => (
                                        <article class="contents-video">
                                            <a
                                                class="contents-video__link"
                                                href={`https://www.youtube.com/watch?v=${video.videoId}`}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                referrerpolicy="no-referrer"
                                                aria-label={`${video.title}をYouTubeで見る（新しいタブ）`}
                                            >
                                                <h3>{video.title}</h3>
                                            </a>
                                        </article>
                                    ))}
                                </div>
                            )}

                            {items.length > 0 && (
                                <div class="contents-island__works">
                                    {items.map((item) => {
                                        const href = getPublicUrl(
                                            item.url ?? null,
                                        );
                                        const image =
                                            item.image?.startsWith(
                                                "/images/",
                                            ) && !item.image.includes("..")
                                                ? item.image
                                                : null;

                                        return (
                                            <article class="contents-work">
                                                {image && (
                                                    <img
                                                        src={image}
                                                        alt=""
                                                        loading="lazy"
                                                        decoding="async"
                                                    />
                                                )}
                                                <div>
                                                    {item.date && (
                                                        <time
                                                            datetime={item.date}
                                                        >
                                                            {formatJapaneseDate(
                                                                item.date,
                                                            )}
                                                        </time>
                                                    )}
                                                    <h3>{item.title}</h3>
                                                    {item.description && (
                                                        <p>
                                                            {item.description}
                                                        </p>
                                                    )}
                                                    {href && (
                                                        <a
                                                            href={href}
                                                            target="_blank"
                                                            rel="noopener noreferrer"
                                                            referrerpolicy="no-referrer"
                                                        >
                                                            見にいく
                                                        </a>
                                                    )}
                                                </div>
                                            </article>
                                        );
                                    })}
                                </div>
                            )}
                        </section>
                    );
                })}

                {availableShops.length > 0 && (
                    <section
                        class:list={[
                            "contents-island",
                            "contents-island--shop",
                            {
                                "contents-island--shop-single":
                                    availableShops.length === 1,
                            },
                        ]}
                    >
                        <header>
                            <p class="eyebrow">SHOP</p>
                            <h2>オリジナルグッズ</h2>
                        </header>
                        <div class="contents-shops">
                            {availableShops.map((item) => (
                                <article class="contents-shop">
                                    {item.image && (
                                        <a
                                            class="contents-shop__image-link"
                                            href={item.href}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            referrerpolicy="no-referrer"
                                            aria-label={`${item.label}の販売サイトを見る`}
                                        >
                                            <img
                                                class="contents-shop__image"
                                                src={item.image.src}
                                                alt=""
                                                loading="lazy"
                                                decoding="async"
                                            />
                                            {item.image.sample && (
                                                <span class="contents-shop__sample">
                                                    SAMPLE
                                                </span>
                                            )}
                                        </a>
                                    )}
                                    <h3>{item.label}</h3>
                                    {item.description && (
                                        <p>{item.description}</p>
                                    )}
                                    <a
                                        href={item.href}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        referrerpolicy="no-referrer"
                                    >
                                        見てみる
                                    </a>
                                </article>
                            ))}
                        </div>
                    </section>
                )}
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .contents-videos {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: clamp(12px, 1.7vw, 20px);
        margin-bottom: 22px;
    }

    .contents-video {
        min-width: 0;
        border: 1px solid rgba(149, 197, 226, 0.74);
        border-radius: 19px;
        background:
            radial-gradient(
                circle at 92% 9%,
                rgba(255, 255, 255, 0.95),
                transparent 27%
            ),
            linear-gradient(125deg, #f7fcff, #e9f5fd 58%, #dceefa);
        box-shadow: 0 10px 24px rgba(75, 132, 171, 0.07);
        overflow: hidden;
        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease,
            transform 0.2s ease;
    }

    .contents-video__link {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 128px;
        height: 100%;
        padding: 24px 25px;
        box-sizing: border-box;
        color: #326e90;
        text-decoration: none;
        text-align: center;
        isolation: isolate;
    }

    .contents-video__link::before,
    .contents-video__link::after {
        position: absolute;
        z-index: -1;
        color: #a0cee5;
        font-family: "Segoe UI Symbol", "Noto Sans Symbols 2", sans-serif;
        font-weight: 400;
        line-height: 1;
    }

    .contents-video__link::before {
        content: "☆";
        top: 13px;
        left: 16px;
        font-size: 16px;
    }

    .contents-video__link::after {
        content: "○";
        bottom: 11px;
        right: 18px;
        font-size: 14px;
        opacity: 0.8;
    }

    .contents-video h3 {
        margin: 0;
        font-size: clamp(14px, 1.45vw, 17px);
        font-weight: 800;
        line-height: 1.7;
        overflow-wrap: anywhere;
    }

    .contents-video__link:focus-visible {
        outline: 3px solid #559cc5;
        outline-offset: -4px;
    }

    @media (hover: hover) {
        .contents-video:hover {
            border-color: #95c7e3;
            box-shadow: 0 13px 30px rgba(75, 132, 171, 0.13);
            transform: translateY(-3px);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .contents-video {
            transition: none;
        }
        .contents-video:hover {
            transform: none;
        }
    }

    .contents-islands > .contents-island.contents-island--shop {
        width: 100%;
        max-width: 850px;
        margin-inline: auto;
        box-sizing: border-box;
        padding: clamp(24px, 3.5vw, 38px);
        border-radius: 38px;
    }

    .contents-islands > .contents-island.contents-island--shop-single {
        max-width: 440px;
    }

    .contents-island--shop .contents-shops {
        display: grid;
        grid-template-columns: repeat(
            auto-fit,
            minmax(min(100%, 220px), 270px)
        );
        justify-content: center;
        gap: 15px;
    }

    .contents-island--shop .contents-shop {
        box-sizing: border-box;
        width: 100%;
        max-width: 270px;
        min-width: 0;
        padding: 18px 20px;
        margin: 0;
    }

    .contents-island--shop .contents-shop__image-link {
        position: relative;
        display: block;
        margin-bottom: 15px;
        border-radius: 16px 26px 18px 23px;
        overflow: hidden;
        background: #e6f3fc;
        text-decoration: none;
    }

    .contents-island--shop .contents-shop__image {
        display: block;
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        object-position: center 55%;
        transition: transform 0.25s ease;
    }

    .contents-island--shop .contents-shop__sample {
        position: absolute;
        right: 9px;
        bottom: 9px;
        padding: 4px 8px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.9);
        color: #56829c;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.08em;
    }

    .contents-island--shop .contents-shop__image-link:focus-visible {
        outline: 3px solid #559cc5;
        outline-offset: 3px;
    }

    @media (hover: hover) {
        .contents-island--shop
            .contents-shop__image-link:hover
            .contents-shop__image {
            transform: scale(1.035);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .contents-island--shop .contents-shop__image {
            transition: none;
        }
    }

    .contents-island--shop .contents-shop h3 {
        margin: 0 0 8px;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .contents-island--shop .contents-shop p {
        margin: 0 0 14px;
        line-height: 1.7;
        overflow-wrap: anywhere;
    }

    @media (max-width: 1050px) {
        .contents-videos {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 640px) {
        .contents-videos {
            grid-template-columns: minmax(0, 1fr);
        }

        .contents-video__link {
            min-height: 96px;
            padding: 20px 26px;
        }

        .contents-islands > .contents-island.contents-island--shop {
            padding: 24px 18px;
            border-radius: 28px;
        }
    }
</style>
