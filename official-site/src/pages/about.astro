---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { pageText } from "../data/pages";
import { activityGenres } from "../data/profile";
import { historyEntries } from "../data/history";
import HistoryEntries from "../components/HistoryEntries.astro";

const profileImagePath: string = "/images/gomibako_bakusou.png";
---

<BaseLayout title="About me">
  <section class="about-page">
    <div class="container">
      <header class="about-page__hero">
        <div class="about-page__copy">
          <p class="eyebrow">ABOUT ME</p>
          <h1>わたしのこと</h1>
          <p class="about-page__lead">{pageText.about.introduction}</p>
        </div>

        <div class="about-page__visual">
          <div class="about-page__visual-glow" aria-hidden="true"></div>
          <div
            class="about-page__visual-back about-page__visual-back--one"
            aria-hidden="true"
          ></div>
          <div
            class="about-page__visual-back about-page__visual-back--two"
            aria-hidden="true"
          ></div>

          <div class="about-page__visual-frame">
            <div class="about-page__visual-shape">
              {pageText.home.mainVisualImage ? (
                <img
                  src={pageText.home.mainVisualImage}
                  alt={pageText.home.mainVisualAlt}
                  loading="eager"
                  decoding="async"
                />
              ) : (
                <p>{pageText.home.mainVisualPlaceholder}</p>
              )}
            </div>
          </div>

          <span
            class="about-page__pearl about-page__pearl--one"
            aria-hidden="true"
          >
            ○
          </span>
          <span
            class="about-page__pearl about-page__pearl--two"
            aria-hidden="true"
          >
            ○
          </span>
          <span
            class="about-page__pearl about-page__pearl--three"
            aria-hidden="true"
          >
            ○
          </span>
        </div>
      </header>

      <div class="about-page__overview">
        <section class="about-page__card about-page__card--large">
          <div class="about-page__profile-title">
            <p class="eyebrow">PROFILE</p>
            <h2>{site.fullName}の生態</h2>
            {profileImagePath && (
              <img
                class="about-page__profile-image"
                src={profileImagePath}
                alt={`${site.fullName}のプロフィール画像`}
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
          <p class="about-page__profile-text">{pageText.about.profile}</p>
        </section>

        <section class="about-page__card about-page__card--story">
          <p class="eyebrow">MY STORY</p>
          <h2>これまでのこと</h2>
          <HistoryEntries entries={historyEntries} />
        </section>
      </div>

      <div class="about-page__details">
        <section class="about-page__card about-page__detail-card about-page__card--activities">
          <p class="eyebrow">ACTIVITIES</p>
          <h2>主な配信タイトル</h2>
          {activityGenres.length > 0 ? (
            <ul class="about-page__chips">
              {activityGenres.map((genre) => (
                <li>{genre}</li>
              ))}
            </ul>
          ) : (
            <p>
              overwatchやApexLegends等のFPSから、作業雑談、歌枠、ホラーゲームの配信も行っています
            </p>
          )}
        </section>

        <section class="about-page__card about-page__detail-card about-page__card--future">
          <p class="eyebrow">FROM NOW</p>
          <h2>これからのこと</h2>
          <p>{pageText.about.future}</p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page__profile-text,
  .about-page__detail-card > p:not(.eyebrow) {
    margin: 0;
    font-size: clamp(13px, 1.4vw, 15px);
    line-height: 1.9;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  .about-page {
    position: relative;
    overflow: hidden;
    padding: clamp(42px, 7vw, 85px) 0 clamp(85px, 10vw, 130px);
    background:
      radial-gradient(
        ellipse at 87% 10%,
        rgba(211, 231, 255, 0.65),
        transparent 35%
      ),
      radial-gradient(
        ellipse at 7% 68%,
        rgba(226, 238, 255, 0.45),
        transparent 32%
      );
  }

  .about-page > .container {
    position: relative;
    z-index: 1;
  }

  .about-page__hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(290px, 410px);
    align-items: center;
    gap: clamp(25px, 5vw, 78px);
    margin-bottom: clamp(60px, 8vw, 110px);
  }

  .about-page__copy h1 {
    margin: 12px 0 20px;
    color: #376e8b;
    font-size: clamp(25px, 3.6vw, 49px) !important;
    font-weight: 800;
    line-height: 1.48;
    letter-spacing: 0.025em;
    text-shadow:
      0 3px rgba(255, 255, 255, 0.9),
      0 13px 29px rgba(109, 166, 198, 0.14);
  }

  .about-page__lead {
    max-width: none;
    margin: 0;
    color: var(--color-text-muted);
    font-size: clamp(11px, 1.5vw, 14px);
    line-height: 2.1;
    white-space: pre-line;
  }

  .about-page__visual {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    width: min(100%, 385px);
    aspect-ratio: 3 / 4;
    margin-inline: auto;
    animation: about-visual-float 9s ease-in-out infinite;
  }

  .about-page__visual-glow {
    position: absolute;
    inset: 7% 2%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(
      ellipse,
      rgba(255, 255, 255, 0.98),
      rgba(186, 222, 244, 0.4) 66%,
      transparent 76%
    );
    filter: blur(12px);
  }

  .about-page__visual-back {
    position: absolute;
    width: 86%;
    height: 86%;
    border: 1px solid rgba(255, 255, 255, 0.84);
    border-radius: 90px 72px 96px 80px / 106px 92px 112px 98px;
    background: rgba(242, 249, 255, 0.22);
    pointer-events: none;
  }

  .about-page__visual-back--one {
    transform: rotate(-8deg) translate(-6px, 4px);
  }

  .about-page__visual-back--two {
    transform: rotate(7deg) translate(7px, -4px);
    border-color: rgba(162, 207, 231, 0.46);
  }

  .about-page__visual-frame {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 83%;
    aspect-ratio: 3 / 4;
  }

  .about-page__visual-shape {
    display: grid;
    place-items: center;
    overflow: hidden;
    width: 100%;
    height: 100%;
    border: 1px solid rgba(255, 255, 255, 0.94);
    border-radius: 84px 73px 88px 70px / 106px 86px 100px 98px;
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.96),
      rgba(227, 243, 253, 0.79)
    );
    box-shadow:
      0 25px 58px rgba(107, 170, 206, 0.18),
      inset 0 0 0 6px rgba(255, 255, 255, 0.35);
  }

  .about-page__visual-shape img {
    display: block;
    width: 92%;
    height: 92%;
    min-width: 0;
    min-height: 0;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .about-page__visual-shape p {
    max-width: 14ch;
    margin: 0;
    color: #7299b0;
    font-size: 13px;
    line-height: 2;
    text-align: center;
  }

  .about-page__pearl {
    position: absolute;
    z-index: 2;
    color: #a0cbe2;
    font-size: 24px;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .about-page__pearl--one {
    top: 18%;
    right: 1%;
    font-size: 23px;
  }

  .about-page__pearl--two {
    bottom: 21%;
    left: 0;
    font-size: 16px;
  }

  .about-page__pearl--three {
    right: 7%;
    bottom: 8%;
    color: rgba(255, 255, 255, 0.98);
    font-size: 36px;
  }

  .about-page__overview {
    display: grid;
    gap: clamp(20px, 3vw, 32px);
    margin-bottom: clamp(24px, 4vw, 46px);
  }

  .about-page__details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: clamp(18px, 3vw, 34px);
  }

  .about-page__card {
    position: relative;
    min-width: 0;
    padding: clamp(22px, 3vw, 36px);
    border-radius: 42px 55px 38px 50px;
    background: rgba(255, 255, 255, 0.54);
  }

  .about-page__card--large {
    display: grid;
    grid-template-columns: minmax(0, 0.65fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(18px, 3vw, 42px);
    padding: clamp(24px, 3.5vw, 40px);
    border: 1px solid rgba(255, 255, 255, 0.92);
    border-radius: 34px;
    background: linear-gradient(140deg, #fff, #e7f6ff);
    box-shadow: 0 22px 57px rgba(122, 177, 208, 0.12);
  }

  .about-page__profile-title {
    min-width: 0;
  }

  .about-page__profile-title .eyebrow {
    margin-bottom: 8px;
  }

  .about-page__profile-title h2 {
    margin-bottom: 0;
  }

  .about-page__profile-image {
    display: block;
    width: clamp(90px, 10vw, 120px);
    height: auto;
    max-width: 100%;
    margin-top: 14px;
    object-fit: contain;
  }

  .about-page__card--story {
    padding: clamp(24px, 3.5vw, 40px);
    border: 1px solid rgba(190, 220, 237, 0.76);
    border-radius: 32px;
    background: rgba(232, 245, 254, 0.65);
  }

  .about-page__card--story :global(.history-entries__list) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 14px;
  }

  .about-page__card--story :global(.history-entries__item) {
    height: 100%;
  }

  .about-page__detail-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(24px, 3vw, 36px);
    border: 1px solid rgba(190, 220, 237, 0.7);
    border-radius: 32px;
    background: rgba(232, 245, 254, 0.67);
  }

  .about-page__detail-card > .eyebrow {
    margin-bottom: 0;
  }

  .about-page__card h2 {
    margin: 6px 0 16px;
    color: #39728f;
    font-size: clamp(20px, 2.7vw, 20px);
  }

  .about-page__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .about-page__chips li {
    padding: 5px 15px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.76);
    color: #5485a1;
    font-size: clamp(10px, 1.3vw, 14px);
  }

  @keyframes about-visual-float {
    0%,
    100% {
      transform: translateY(0) rotate(-1deg);
    }
    50% {
      transform: translateY(-9px) rotate(1deg);
    }
  }

  @media (max-width: 760px) {
    .about-page__hero,
    .about-page__details {
      grid-template-columns: minmax(0, 1fr);
    }

    .about-page__card--large {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .about-page__card--story :global(.history-entries__list) {
      grid-template-columns: minmax(0, 1fr);
    }

    .about-page__hero {
      gap: 24px;
    }

    .about-page__visual {
      width: min(100%, 345px);
    }

    .about-page__details {
      gap: 18px;
    }
  }

  @media (min-width: 521px) and (max-width: 760px) {
    .about-page__copy h1 {
      font-size: clamp(24px, 5.7vw, 36px) !important;
    }
  }

  @media (max-width: 520px) {
    .about-page__hero {
      margin-bottom: 55px;
    }

    .about-page__copy h1 {
      font-size: clamp(22px, 6.7vw, 30px) !important;
    }

    .about-page__visual {
      width: min(100%, 300px);
    }

    .about-page__card--large {
      border-radius: 24px;
    }

    .about-page__card {
      padding: 27px 23px;
    }

    .about-page__detail-card {
      padding: 27px 23px;
      border-radius: 25px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-page__visual {
      animation: none;
    }
  }
</style>
