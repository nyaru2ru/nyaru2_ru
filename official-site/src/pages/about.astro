---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { pageText } from "../data/pages";
import { activityGenres, profileTags } from "../data/profile";
import { getPublicUrl } from "../data/links";
---

<BaseLayout title="About me">
  <section class="about-page">
    <div class="container">
      <header class="about-page__hero">
        <div class="about-page__copy">
          <p class="eyebrow">ABOUT ME</p>
          <h1>わたしのこと</h1>
          <p class="about-page__lead">{pageText.about.introduction}</p>
        </div>

        <div class="about-page__visual">
          <div class="about-page__visual-glow" aria-hidden="true"></div>
          <div
            class="about-page__visual-back about-page__visual-back--one"
            aria-hidden="true"
          >
          </div>
          <div
            class="about-page__visual-back about-page__visual-back--two"
            aria-hidden="true"
          >
          </div>

          <div class="about-page__visual-frame">
            <div class="about-page__visual-shape">
              {
                pageText.home.mainVisualImage ? (
                  <img
                    src={pageText.home.mainVisualImage}
                    alt={pageText.home.mainVisualAlt}
                    loading="eager"
                    decoding="async"
                  />
                ) : (
                  <p>{pageText.home.mainVisualPlaceholder}</p>
                )
              }
            </div>
          </div>

          <span
            class="about-page__pearl about-page__pearl--one"
            aria-hidden="true">○</span
          >
          <span
            class="about-page__pearl about-page__pearl--two"
            aria-hidden="true">○</span
          >
          <span
            class="about-page__pearl about-page__pearl--three"
            aria-hidden="true">○</span
          >
        </div>
      </header>

      <div class="about-page__profile">
        <section class="about-page__card about-page__card--large">
          <p class="eyebrow">PROFILE</p>
          <h2>{site.fullName}</h2>
          <p>{pageText.about.profile}</p>
        </section>

        <div class="about-page__chapters">
          <section class="about-page__card about-page__card--story">
            <p class="eyebrow">MY STORY</p>
            <h2>これまでのこと</h2>
            <p id="about-story" class="about-page__story-text">{pageText.about.history}</p>
            <button
              type="button"
              class="about-page__story-toggle"
              aria-controls="about-story"
              aria-expanded="false"
              hidden
            >
              もっと見る
            </button>
          </section>

          <section class="about-page__card about-page__card--future">
            <p class="eyebrow">FROM NOW</p>
            <h2>これからのこと</h2>
            <p>{pageText.about.future}</p>
          </section>
        </div>
      </div>

      <div class="about-page__meta">
        <section class="about-page__softbox">
          <p class="eyebrow">ACTIVITIES</p>
          <h2>主な配信タイトル</h2>
          {
            activityGenres.length > 0 ? (
              <ul class="about-page__chips">
                {activityGenres.map((genre) => (
                  <li>{genre}</li>
                ))}
              </ul>
            ) : (
              <p>OverWatch2　Apex　新幹線 0号　ミサイド etc...</p>
            )
          }
        </section>

        <section class="about-page__softbox about-page__softbox--tags">
          <p class="eyebrow">TAGS</p>
          <h2>各種タグ</h2>
          {
            profileTags.length > 0 ? (
              <dl class="about-page__tags">
                {profileTags.map((item) => {
                  const href = getPublicUrl(item.url ?? null);
                  return (
                    <div>
                      <dt>{item.label}</dt>
                      <dd>
                        {href ? (
                          <a
                            href={href}
                            target="_blank"
                            rel="noopener noreferrer"
                            referrerpolicy="no-referrer"
                          >
                            {item.tag}
                          </a>
                        ) : (
                          item.tag
                        )}
                      </dd>
                    </div>
                  );
                })}
              </dl>
            ) : (
              <p>各種タグは準備中です。</p>
            )
          }
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.about-page__softbox > p:not(.eyebrow),
.about-page__card--large > p:not(.eyebrow),
.about-page__card--future > p:not(.eyebrow) {
  font-size: clamp(10px, 1.2vw + 4px, 16px);
}

.about-page p:not(.eyebrow) {
  white-space: pre-line;
  overflow-wrap: break-word;
}

  .about-page__story-text {
    line-height: 2.1;
    overflow-wrap: break-word;
  }

  .about-page__story-text.is-collapsed {
    max-height: 29.4em;
    overflow: hidden;
  }

  .about-page__story-toggle {
    margin-top: 12px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #39728f;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .about-page__story-toggle[hidden] {
    display: none;
  }

  .about-page__story-toggle:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .about-page__story-toggle:focus-visible {
    outline: 2px solid #39728f;
    outline-offset: 4px;
  }

  .about-page {
    position: relative;
    overflow: hidden;
    padding: clamp(42px, 7vw, 85px) 0 clamp(85px, 10vw, 130px);
    background:
      radial-gradient(
        ellipse at 87% 10%,
        rgba(211, 231, 255, 0.65),
        transparent 35%
      ),
      radial-gradient(
        ellipse at 7% 68%,
        rgba(226, 238, 255, 0.45),
        transparent 32%
      );
  }

  .about-page > .container {
    position: relative;
    z-index: 1;
  }

  .about-page__hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(290px, 410px);
    align-items: center;
    gap: clamp(25px, 5vw, 78px);
    margin-bottom: clamp(60px, 8vw, 110px);
  }

  .about-page__copy h1 {
    margin: 12px 0 20px;
    color: #376e8b;
    font-size: clamp(25px, 3.6vw, 49px) !important;
    font-weight: 800;
    line-height: 1.48;
    letter-spacing: 0.025em;
    text-shadow:
      0 3px rgba(255, 255, 255, 0.9),
      0 13px 29px rgba(109, 166, 198, 0.14);
  }

  .about-page__lead {
    max-width: none;
    margin: 0;
    color: var(--color-text-muted);
    font-size: clamp(15px, 1.5vw, 18px);
    line-height: 2.1;
    white-space: pre-line;
  }

  .about-page__visual {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    width: min(100%, 385px);
    aspect-ratio: 3 / 4;
    margin-inline: auto;
    animation: about-visual-float 9s ease-in-out infinite;
  }

  .about-page__visual-glow {
    position: absolute;
    inset: 7% 2%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(
      ellipse,
      rgba(255, 255, 255, 0.98),
      rgba(186, 222, 244, 0.4) 66%,
      transparent 76%
    );
    filter: blur(12px);
  }

  .about-page__visual-back {
    position: absolute;
    width: 86%;
    height: 86%;
    border: 1px solid rgba(255, 255, 255, 0.84);
    border-radius: 90px 72px 96px 80px / 106px 92px 112px 98px;
    background: rgba(242, 249, 255, 0.22);
    pointer-events: none;
  }

  .about-page__visual-back--one {
    transform: rotate(-8deg) translate(-6px, 4px);
  }

  .about-page__visual-back--two {
    transform: rotate(7deg) translate(7px, -4px);
    border-color: rgba(162, 207, 231, 0.46);
  }

  .about-page__visual-frame {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 83%;
    aspect-ratio: 3 / 4;
  }

  .about-page__visual-shape {
    display: grid;
    place-items: center;
    overflow: hidden;
    width: 100%;
    height: 100%;
    border: 1px solid rgba(255, 255, 255, 0.94);
    border-radius: 84px 73px 88px 70px / 106px 86px 100px 98px;
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.96),
      rgba(227, 243, 253, 0.79)
    );
    box-shadow:
      0 25px 58px rgba(107, 170, 206, 0.18),
      inset 0 0 0 6px rgba(255, 255, 255, 0.35);
  }

  .about-page__visual-shape img {
    display: block;
    width: 92%;
    height: 92%;
    min-width: 0;
    min-height: 0;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .about-page__visual-shape p {
    max-width: 14ch;
    margin: 0;
    color: #7299b0;
    font-size: 13px;
    line-height: 2;
    text-align: center;
  }

  .about-page__pearl {
    position: absolute;
    z-index: 2;
    color: #a0cbe2;
    font-size: 24px;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .about-page__pearl--one {
    top: 18%;
    right: 1%;
    font-size: 23px;
  }

  .about-page__pearl--two {
    bottom: 21%;
    left: 0;
    font-size: 16px;
  }

  .about-page__pearl--three {
    right: 7%;
    bottom: 8%;
    color: rgba(255, 255, 255, 0.98);
    font-size: 36px;
  }

  .about-page__profile {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(24px, 5vw, 65px);
    align-items: center;
    margin-bottom: clamp(35px, 5vw, 65px);
  }

  .about-page__chapters {
    display: grid;
    gap: clamp(23px, 3vw, 37px);
  }

  .about-page__card {
    position: relative;
    min-width: 0;
    padding: clamp(22px, 3vw, 36px);
    border-radius: 42px 55px 38px 50px;
    background: rgba(255, 255, 255, 0.54);
  }

  .about-page__card--large {
    padding: clamp(35px, 5vw, 63px);
    border: 1px solid rgba(255, 255, 255, 0.92);
    border-radius: 45% 55% 40% 60% / 28% 26% 29% 31%;
    background: linear-gradient(140deg, #fff, #e7f6ff);
    box-shadow: 0 22px 57px rgba(122, 177, 208, 0.12);
  }

  .about-page__card--story {
    margin-right: 8%;
  }

  .about-page__card--future {
    margin-left: 7%;
    background: rgba(232, 245, 254, 0.67);
  }

  .about-page__card h2,
  .about-page__softbox h2 {
    margin: 6px 0 16px;
    color: #39728f;
    font-size: clamp(23px, 2.7vw, 32px);
  }

  .about-page__card--story > p:not(.eyebrow) {
    font-size: clamp(14px, 1.2vw, 16px);
    white-space: pre-line;
    overflow-wrap: break-word;
  }

  .about-page__meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: clamp(22px, 5vw, 60px);
    padding: clamp(25px, 5vw, 65px);
    border-radius: 48px 70px 42px 65px;
    background: rgba(229, 245, 254, 0.61);
  }

  .about-page__softbox {
    min-width: 0;
  }

  .about-page__softbox--tags {
    padding-top: clamp(15px, 3vw, 35px);
  }

  .about-page__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .about-page__chips li {
    padding: 5px 15px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.76);
    color: #5485a1;
    font-size: clamp(14px, 1.3vw, 18px);
  }

  .about-page__tags {
    display: grid;
    gap: 3px;
    margin: 15px 0 0;
  }

  .about-page__tags div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 15px;
    padding: 10px 0;
    border-bottom: 1px dashed rgba(153, 197, 223, 0.65);
  }

  .about-page__tags dt {
    color: #6a90a5;
    font-size: 13px;
  }

  .about-page__tags dd {
    margin: 0;
    color: #4381a1;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .about-page__tags a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @keyframes about-visual-float {
    0%,
    100% {
      transform: translateY(0) rotate(-1deg);
    }
    50% {
      transform: translateY(-9px) rotate(1deg);
    }
  }

  @media (max-width: 760px) {
    .about-page__hero,
    .about-page__profile,
    .about-page__meta {
      grid-template-columns: minmax(0, 1fr);
    }

    .about-page__hero {
      gap: 24px;
    }

    .about-page__visual {
      width: min(100%, 345px);
    }

    .about-page__profile {
      gap: 20px;
    }

    .about-page__meta {
      gap: 32px;
    }

    .about-page__card--future {
      margin-left: 0;
    }
  }

  @media (min-width: 521px) and (max-width: 760px) {
    .about-page__copy h1 {
      font-size: clamp(24px, 5.7vw, 36px) !important;
    }
  }

  @media (max-width: 520px) {
    .about-page__hero {
      margin-bottom: 55px;
    }

    .about-page__copy h1 {
      font-size: clamp(22px, 6.7vw, 30px) !important;
    }

    .about-page__visual {
      width: min(100%, 300px);
    }

    .about-page__card--large {
      border-radius: 70px 80px 63px 75px / 63px 68px 64px 82px;
    }

    .about-page__card {
      padding: 27px 23px;
    }

    .about-page__meta {
      padding: 32px 25px;
      border-radius: 40px 47px 40px 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-page__visual {
      animation: none;
    }
  }
</style>

<script>
  const story = document.getElementById("about-story");
  const toggle = document.querySelector<HTMLButtonElement>(".about-page__story-toggle");

  if (story && toggle) {
    const update = () => {
      const lineHeight = parseFloat(getComputedStyle(story).lineHeight);
      const overflow = story.scrollHeight > lineHeight * 14 + 1;

      toggle.hidden = !overflow;

      if (!overflow) {
        story.classList.remove("is-collapsed");
        toggle.setAttribute("aria-expanded", "false");
        toggle.textContent = "もっと見る";
      } else if (toggle.getAttribute("aria-expanded") !== "true") {
        story.classList.add("is-collapsed");
      }
    };

    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      story.classList.toggle("is-collapsed", expanded);
      toggle.setAttribute("aria-expanded", String(!expanded));
      toggle.textContent = expanded ? "もっと見る" : "閉じる";
    });

    window.addEventListener("resize", update);
    document.fonts.ready.then(update);
    update();
  }
</script>