---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { activityItems } from "../data/activity";
import { pageText } from "../data/pages";
import { getSiteOrPublicUrl } from "../data/links";
const categories = [
  { id: "news", label: "NEWS", title: "お知らせ" },
  { id: "achievement", label: "ACTIVITY", title: "活動実績" },
  { id: "event", label: "EVENT", title: "大会・イベント" },
  { id: "collaboration", label: "COLLAB", title: "コラボ" },
  { id: "schedule", label: "FUTURE", title: "今後の予定" }
] as const;
---

<BaseLayout title="Activity">
  <section class="section activity-page">
    <div class="container">
      <PageHeader label="ACTIVITY" title="これまでと、これから" description={pageText.activity.introduction} />
      <div class="activity-diary">
        {categories.map((category, index) => {
          const items = [...activityItems].filter((item) => item.category === category.id).sort((a, b) => b.date.localeCompare(a.date));
          return <section class="activity-diary__chapter">
            <div class="activity-diary__heading"><span aria-hidden="true">{index % 2 ? "♡" : "☆"}</span><p class="eyebrow">{category.label}</p><h2>{category.title}</h2></div>
            {items.length ? (
              <ol class="activity-diary__events">
                {items.map((item) => {
                  const href = getSiteOrPublicUrl(item.url ?? null);
                  const external = href?.startsWith("https://") ?? false;
                  return <li>
                    <time datetime={item.date}>{item.date.replaceAll("-", ".")}</time>
                    <h3>{href ? <a href={href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined} referrerpolicy={external ? "no-referrer" : undefined}>{item.title}</a> : item.title}</h3>
                    <p>{item.description}</p>
                  </li>;
                })}
              </ol>
            ) : <p class="activity-diary__empty">お知らせを準備中です。</p>}

          </section>;
        })}
      </div>
    </div>
  </section>
</BaseLayout>
