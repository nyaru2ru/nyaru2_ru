  }

  @keyframes site-mark-float {
    0%,
    100% {
      transform: translate(-50%, -50%) translate(0, 0) rotate(-3deg);
    }

    50% {
      transform: translate(-50%, -50%)
        translate(2px, calc(-1 * var(--site-mark-float))) rotate(3deg);
    }
  }

  @keyframes site-stream-drift {
    0%,
    100% {
      transform: translate(-50%, -50%) rotate(var(--stream-angle)) translateX(0);
    }

    50% {
