  }

  .site-stream {
    position: absolute;
    width: var(--stream-width);
    height: var(--stream-height);

    transform: translate(-50%, -50%) rotate(var(--stream-angle));

    transform-origin: center;
    opacity: var(--stream-opacity);
    border-radius: 999px;

    background: linear-gradient(
