      rgba(186, 220, 241, 0.14) 0%,
      rgba(186, 220, 241, 0.24) 28%,
      rgba(186, 220, 241, 0.38) 56%,
      rgba(186, 220, 241, 0.58) 78%,
      rgba(186, 220, 241, 0.74) 100%
    );

    clip-path: polygon(0 68%, 0 88%, 100% 0, 100% 100%);

    filter: blur(0.2px);

    animation: site-stream-drift 14s ease-in-out infinite;

    animation-delay: var(--stream-delay);
  }

  .site-mark {
    position: absolute;
    display: inline-block;

    font-family: "Segoe UI Symbol", "Noto Sans Symbols 2", sans-serif;

    font-size: var(--mark-size);
    line-height: 1;
    font-weight: 400;
    white-space: nowrap;

    color: var(--site-mark-color);

    transform: translate(-50%, -50%);

    text-shadow: 0 2px 8px rgba(110, 169, 206, 0.12);

    animation: site-mark-float var(--mark-speed) ease-in-out infinite;

    animation-delay: var(--mark-delay);
  }

  .site-mark--focus {
