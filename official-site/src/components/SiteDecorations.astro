    }
  }

  .site-decor-ready .home-hero__sky,
  .site-decor-ready .home-visual__deco,
  .site-decor-ready .home-hero__action-star,
  .site-decor-ready .home-about__turn-mark,
  .site-decor-ready .home-about__visual-deco,
  .site-decor-ready .page-intro__decor,
  .site-decor-ready .weekview__decor,
  .site-decor-ready .weekview__next-ornaments,
  .site-decor-ready .weekview__links-star,
