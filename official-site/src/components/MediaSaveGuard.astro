---

---

<div
    class="media-save-guard"
    data-media-save-guard
    hidden
    role="dialog"
    aria-label="閲覧用画像の保存"
>
    <p class="media-save-guard__title">画像の保存について</p>
    <p class="media-save-guard__description">
        閲覧用の小さな画像（最大480px・透かし入り）を保存できます。
    </p>
    <p
        class="media-save-guard__message"
        data-media-save-message
        aria-live="polite"
    >
    </p>
    <div class="media-save-guard__actions">
        <button type="button" data-media-save-export>閲覧用画像を保存</button>
        <button type="button" data-media-save-close>閉じる</button>
    </div>
</div>

<style is:global>
    img:not([data-media-save-allow]),
    video:not([data-media-save-allow]) {
        -webkit-user-drag: none;
        -webkit-touch-callout: none;
        -webkit-user-select: none;
        user-select: none;
    }

    .media-save-guard[hidden] {
        display: none !important;
    }

    .media-save-guard {
        position: fixed;
        z-index: 2147483640;
        box-sizing: border-box;
        width: min(290px, calc(100vw - 24px));
        max-height: calc(100dvh - 24px);
        overflow: auto;
        padding: 15px;
        border: 1px solid #b9dceb;
        border-radius: 18px;
        background: #fff;
        color: #315d76;
        box-shadow: 0 14px 40px rgba(39, 88, 122, 0.2);
        font-family: inherit;
        text-align: left;
    }

    .media-save-guard__title {
        margin: 0 0 6px;
        font-size: 14px;
        font-weight: 800;
    }

    .media-save-guard__description,
    .media-save-guard__message {
        margin: 0 0 10px;
        font-size: 12px;
        line-height: 1.7;
    }

    .media-save-guard__message:empty {
        display: none;
    }
    .media-save-guard__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .media-save-guard__actions button {
        min-height: 38px;
        padding: 7px 12px;
        border: 1px solid #b3d9ec;
        border-radius: 999px;
        background: #eaf7ff;
        color: #2f708f;
        font: inherit;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
    }

    .media-save-guard__actions button:last-child {
        background: #fff;
    }
    .media-save-guard__actions button:focus-visible {
        outline: 3px solid #6caed1;
        outline-offset: 2px;
    }
</style>

<script>
    const menu = document.querySelector<HTMLDivElement>(
        "[data-media-save-guard]",
    );
    const saveButton = menu?.querySelector<HTMLButtonElement>(
        "[data-media-save-export]",
    );
    const closeButton = menu?.querySelector<HTMLButtonElement>(
        "[data-media-save-close]",
    );
    const message = menu?.querySelector<HTMLParagraphElement>(
        "[data-media-save-message]",
    );

    let currentImage: HTMLImageElement | null = null;

    function closeMenu() {
        if (!menu) return;
        menu.hidden = true;
        currentImage = null;
        if (message) message.textContent = "";
    }

    function protectedMedia(element: EventTarget | null): Element | null {
        if (!(element instanceof Element)) return null;
        const media = element.closest("img, video");
        if (!media || media.closest("[data-media-save-allow]")) return null;
        return media;
    }

    function showMenu(event: MouseEvent, media: Element): void {
        if (!menu || !saveButton || !message) return;
        currentImage = media instanceof HTMLImageElement ? media : null;
        saveButton.hidden = !currentImage;
        message.textContent = currentImage
            ? ""
            : "動画の保存用変換には対応していません。";

        menu.hidden = false;
        menu.style.left = "12px";
        menu.style.top = "12px";
        const rect = menu.getBoundingClientRect();
        const left = Math.max(
            12,
            Math.min(event.clientX, window.innerWidth - rect.width - 12),
        );
        const top = Math.max(
            12,
            Math.min(event.clientY, window.innerHeight - rect.height - 12),
        );
        menu.style.left = `${left}px`;
        menu.style.top = `${top}px`;
        if (!saveButton.hidden) saveButton.focus();
        else closeButton?.focus();
    }

    document.addEventListener(
        "contextmenu",
        (event) => {
            const media = protectedMedia(event.target);
            if (!media) return;
            event.preventDefault();
            showMenu(event, media);
        },
        true,
    );

    document.addEventListener(
        "dragstart",
        (event) => {
            if (protectedMedia(event.target)) event.preventDefault();
        },
        true,
    );

    document
        .querySelectorAll("video:not([data-media-save-allow])")
        .forEach((video) => {
            video.setAttribute("controlsList", "nodownload");
            video.setAttribute("disablePictureInPicture", "");
        });

    document.addEventListener("pointerdown", (event) => {
        if (
            menu &&
            !menu.hidden &&
            event.target instanceof Node &&
            !menu.contains(event.target)
        ) {
            closeMenu();
        }
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menu && !menu.hidden) closeMenu();
    });

    closeButton?.addEventListener("click", closeMenu);

    saveButton?.addEventListener("click", () => {
        if (!(currentImage instanceof HTMLImageElement) || !message) return;
        const image = currentImage;
        if (!image.complete || !image.naturalWidth || !image.naturalHeight) {
            message.textContent =
                "画像の読み込み後に、もう一度お試しください。";
            return;
        }

        const scale = Math.min(
            1,
            480 / Math.max(image.naturalWidth, image.naturalHeight),
        );
        const width = Math.max(1, Math.round(image.naturalWidth * scale));
        const height = Math.max(1, Math.round(image.naturalHeight * scale));
        const canvas = document.createElement("canvas");
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext("2d");
        if (!ctx) {
            message.textContent =
                "このブラウザでは保存用画像を生成できません。";
            return;
        }

        try {
            ctx.drawImage(image, 0, 0, width, height);
            ctx.save();
            ctx.translate(width / 2, height / 2);
            ctx.rotate(-Math.PI / 6);
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            ctx.font = "700 16px sans-serif";
            ctx.lineWidth = 2;
            const span = Math.hypot(width, height);
            for (let y = -span; y <= span; y += 110) {
                for (let x = -span; x <= span; x += 185) {
                    ctx.globalAlpha = 0.24;
                    ctx.strokeStyle = "#ffffff";
                    ctx.strokeText("© OFFICIAL SITE", x, y);
                    ctx.globalAlpha = 0.2;
                    ctx.fillStyle = "#263f58";
                    ctx.fillText("© OFFICIAL SITE", x, y);
                }
            }
            ctx.restore();

            canvas.toBlob((blob) => {
                if (!blob) {
                    message.textContent = "保存用画像の生成に失敗しました。";
                    return;
                }
                const blobUrl = URL.createObjectURL(blob);
                const link = document.createElement("a");
                link.href = blobUrl;
                link.download = "official-site-viewing-copy-480px.png";
                document.body.append(link);
                link.click();
                link.remove();
                window.setTimeout(() => URL.revokeObjectURL(blobUrl), 30_000);
                closeMenu();
            }, "image/png");
        } catch {
            message.textContent = "この画像は閲覧用コピーを作成できません。";
        }
    });
</script>
